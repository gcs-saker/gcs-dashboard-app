{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gcs-saker.local/contracts/mission/v1/mission-dispatch.schema.json",
  "title": "Mission dispatch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["missionId", "missionRevision", "commandId", "assetUuid", "assetSessionId", "issuedAt", "expiresAt", "altitudeDatum", "operatorConfirmed", "waypoints"],
  "properties": {
    "missionId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "missionRevision": { "type": "integer", "minimum": 1 },
    "commandId": { "type": "string", "format": "uuid" },
    "assetUuid": { "type": "string", "minLength": 1, "maxLength": 128 },
    "assetSessionId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "altitudeDatum": { "enum": ["AGL", "MSL"] },
    "operatorConfirmed": { "const": true },
    "waypoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "latitude", "longitude", "altitudeM", "holdSeconds", "action"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "altitudeM": { "type": "number" },
          "holdSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
          "action": { "enum": ["PASS", "HOVER", "LAND", "RETURN_HOME"] }
        }
      }
    }
  }
}

