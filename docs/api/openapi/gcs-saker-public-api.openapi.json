        "responses": {
          "200": {
            "description": "HLS playlist",
            "content": {
              "application/vnd.apple.mpegurl": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/stream/status": {
      "get": {
        "tags": [
          "Legacy"
        ],
        "summary": "legacy stream status smoke",
        "description": "신규 dashboard는 /media-control/api/v1/streams 계열을 사용한다.",
        "security": [],
        "responses": {
          "200": {
            "description": "deprecated compatibility status",
            "headers": {
              "Deprecation": {
                "schema": {
                  "type": "string",
                  "example": "true"
                }
              },
              "X-GCS-Replacement-Route": {
                "schema": {
                  "type": "string",
                  "example": "/media-control/api/v1/streams"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/map/config": {
      "get": {
        "tags": [
          "Legacy"
        ],
        "summary": "legacy map config fallback",
        "description": "auth-policy read model로 이전될 때까지 유지한다.",
        "responses": {
          "200": {
            "description": "map config",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MapConfig"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-GCS-CSRF",
        "description": "브라우저 변경성 요청은 same-origin 값을 사용한다."
      }
    },
    "parameters": {
      "StreamIdPath": {
        "name": "streamId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "example": "raw.local.webcam"
        },
        "description": "API에서는 dot 형식 stream id를 사용한다."
      },
      "StreamPathPath": {
        "name": "streamPath",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "example": "raw/local/webcam"
        },
        "description": "MediaMTX path는 slash 형식을 사용한다."
      },
      "PublisherTokenQuery": {
        "name": "publisherToken",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PlaybackTokenQuery": {
        "name": "playbackToken",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "UuidPath": {
        "name": "uuid",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "PageQuery": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "SizeQuery": {
        "name": "size",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "SeverityQuery": {
        "name": "severity",
        "in": "query",
        "schema": {
          "$ref": "#/components/schemas/EventSeverity"
        }
      },
      "SearchQuery": {
        "name": "q",
        "in": "query",
        "schema": {
          "type": "string"
        }
      },
      "FromQuery": {
        "name": "from",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      },
      "ToQuery": {
        "name": "to",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "responses": {
      "AuthTokenResponse": {
        "description": "인증 성공",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/TokenResponse"
            }
          }
        }
      },
      "HealthResponse": {
        "description": "health response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/HealthResponse"
            }
          }
        }
      },
      "ReadinessResponse": {
        "description": "readiness response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ReadinessResponse"
            }
          }
        }
      },
      "ErrorResponse": {
        "description": "error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "operator"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": [
          "username",
          "password",
          "email",
          "inviteCode"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "inviteCode": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "groupId": {
            "type": "string"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresInSeconds",
          "user"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "bearer"
          },
          "expiresInSeconds": {
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "CurrentUserResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/User"
          }
        ]
      },
      "User": {
        "type": "object",
        "required": [
          "username",
          "role",
          "groupId"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "example": "operator"
          },
          "groupId": {
            "type": "string",
            "example": "co-a"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string"
          }
        }
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "EventSeverity": {
        "type": "string",
        "enum": [
          "info",
          "warn",
          "error"
        ]
      },
      "OperationalEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/EventSeverity"
          },
          "source": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "OperationalEventPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OperationalEvent"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "OperationalEventMetrics": {
        "type": "object",
        "properties": {
          "severityCounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": {
                  "$ref": "#/components/schemas/EventSeverity"
                },
                "count": {
                  "type": "integer"
                }
              }
            }
          },
          "streamSessionMetrics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "icePathCounts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "OperationalEventBucket": {
        "type": "object",
        "properties": {
          "bucketStart": {
            "type": "string",
            "format": "date-time"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "TelemetryIngestRequest": {
        "type": "object",
        "required": [
          "uuid",
          "latitude",
          "longitude",
          "observedAt"
        ],
        "properties": {
          "uuid": {
            "type": "string"
          },
          "streamId": {
            "type": "string"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "altitudeM": {
            "type": "number"
          },
          "headingDeg": {
            "type": "number"
          },
          "speedMps": {
            "type": "number"
          },
          "batteryPercent": {
            "type": "number"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Telemetry": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TelemetryIngestRequest"
          },
          {
            "type": "object",
            "properties": {
              "receivedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "Asset": {
        "type": "object",
        "properties": {
          "gatewayUuid": {
            "type": "string"
          },
          "assetId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ServerHealthSnapshot": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "ok"
          },
          "rttMs": {
            "type": "number"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StreamSession": {
        "type": "object",
        "properties": {
          "streamId": {
            "type": "string"
          },
          "assetId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "icePath": {
            "type": "string",
            "example": "direct"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TimeSyncConfigRequest": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "public",
              "closed-network"
            ]
          },
          "server": {
            "type": "string",
            "description": "폐쇄망에서 직접 지정하는 시간 서버 IP 또는 도메인"
          }
        }
      },
      "TimeSyncStatus": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string"
          },
          "server": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "offsetMs": {
            "type": "number"
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "StreamListResponse": {
        "type": "object",
        "required": [
          "streams"
        ],
        "properties": {
          "streams": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StreamDescriptor"
            }
          }
        }
      },
      "StreamDescriptor": {
        "type": "object",
        "required": [
          "streamId",
          "path",
          "status"
        ],
        "properties": {
          "streamId": {
            "type": "string",
            "example": "raw.local.webcam"
          },
          "path": {
            "type": "string",
            "example": "raw/local/webcam"
          },
          "prefix": {
            "type": "string",
            "example": "raw"
          },
          "assetId": {
            "type": "string"
          },
          "sensorId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "online"
          },
          "displayName": {
            "type": "string"
          },
          "playbackUrls": {
            "$ref": "#/components/schemas/PlaybackUrls"
          }
        }
      },
      "PlaybackUrls": {
        "type": "object",
        "properties": {
          "webrtc": {
            "type": "string",
            "example": "/webrtc/raw/local/webcam/whep?playbackToken=<short-lived-token>"
          },
          "hls": {
            "type": "string",
            "example": "/hls/raw/local/webcam/index.m3u8?playbackToken=<short-lived-token>"
          }
        }
      },
      "StreamPlaybackResponse": {
        "type": "object",
        "properties": {
          "streamId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "playbackUrls": {
            "$ref": "#/components/schemas/PlaybackUrls"
          }
        }
      },
      "StreamPublishResponse": {
        "type": "object",
        "properties": {
          "streamId": {
            "type": "string"
          },
          "whipUrl": {
            "type": "string",
            "example": "/webrtc/raw/local/webcam/whip?publisherToken=<short-lived-token>"
          }
        }
      },
      "StreamStatusResponse": {
        "type": "object",
        "properties": {
          "streamId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "IceServersResponse": {
        "type": "object",
        "required": [
          "iceServers"
        ],
        "properties": {
          "iceServers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IceServer"
            }
          }
        }
      },
      "IceServer": {
        "type": "object",
        "required": [
          "urls"
        ],
        "properties": {
          "urls": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "stun:stun.l.google.com:19302"
          },
          "username": {
            "type": "string"
          },
          "credential": {
            "type": "string"
          }
        }
      },
      "MapConfig": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "example": "esri-satellite"
          },
          "styleUrl": {
            "type": "string"
          },
          "attribution": {
            "type": "string"
          },
          "requiresApiKey": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
