{
  "openapi": "3.1.0",
  "info": {
    "title": "GCS-Saker Public Edge API",
    "version": "0.10.0",
    "description": "Nginx 443 public entrypoint 기준의 협업용 API 문서다. Dashboard, auth-policy, media-control, MediaMTX signaling, HLS fallback, legacy fallback 경계를 한 OpenAPI 문서로 묶는다."
  },
  "servers": [
    {
      "url": "https://a4ai.tplinkdns.com",
      "description": "현재 운영 edge 예시"
    },
    {
      "url": "http://localhost:8080",
      "description": "로컬 single-node edge 예시"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "로그인, 회원가입, refresh, 현재 사용자, logout"
    },
    {
      "name": "Operational",
      "description": "운영 이벤트, 서버 상태, stream session, telemetry read model"
    },
    {
      "name": "Time Sync",
      "description": "공개망/폐쇄망 시간 서버 동기화 설정"
    },
    {
      "name": "Media Control",
      "description": "stream registry, ICE server, playback/publish authorization"
    },
    {
      "name": "Media Plane",
      "description": "MediaMTX WebRTC WHIP/WHEP signaling 및 HLS fallback"
    },
    {
      "name": "Legacy",
      "description": "호환용 fallback route. 신규 기능의 기본 경로로 쓰지 않는다."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-gcs-protocol-boundary": {
    "browserAllowed": [
      "HTTPS JSON",
      "SSE",
      "WHIP",
      "WHEP",
      "HLS"
    ],
    "browserForbidden": [
      "gRPC direct",
      "MQTT direct",
      "DB direct",
      "Redis/DragonFly direct",
      "MediaMTX admin direct"
    ],
    "internalGateway": {
      "grpcService": "gcs.saker.v1.SakerGatewayService",
      "grpcMethod": "/gcs.saker.v1.SakerGatewayService/Exchange",
      "metadata": [
        "x-gcs-gateway-token",
        "authorization: bearer <token>"
      ],
      "payloadKinds": [
        "telemetry",
        "stream_event",
        "command_ack",
        "command",
        "telemetry_batch"
      ]
    },
    "mqttTopics": [
      "gcs/{orgId}/{groupId}/{assetId}/telemetry",
      "gcs/{orgId}/{groupId}/{assetId}/command",
      "gcs/{orgId}/{groupId}/{assetId}/status",
      "gcs/{orgId}/{groupId}/{assetId}/command_ack"
    ],
    "mediaFrameRule": "video/audio media frame은 WebRTC/HLS media plane으로만 보내며 REST, MQTT, gRPC, GraphQL payload에 직접 태우지 않는다."
  },
