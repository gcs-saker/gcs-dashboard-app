# GCS-Saker staging env template.
# Copy to a server-side secret location; do not commit the real file.

COMPOSE_PROJECT_NAME=gcs-saker-staging

MYSQL_ROOT_PASSWORD=replace-outside-git
MYSQL_DATABASE=gcs_db
MYSQL_USER=gcs_app
MYSQL_PASSWORD=replace-outside-git
MYSQL_HOST_PORT=3308
DATABASE_URL=mysql+pymysql://gcs_app:replace-outside-git@mysql:3306/gcs_db

BACKEND_HTTP_PORT=8001
DASHBOARD_HTTP_PORT=3000
BACKEND_IMAGE=gcs-saker-backend:staging
DASHBOARD_IMAGE=gcs-saker-dashboard:staging

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_CLIENT_ID=gcs_backend_staging
MQTT_KEEPALIVE=60

VITE_API_BASE_URL=/api
VITE_HLS_BASE_URL=/hls
VITE_DEFAULT_STREAM_ID=CID001

MEDIAMTX_IMAGE=bluenviron/mediamtx:latest
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=https://media-staging.example.invalid
MEDIAMTX_PUBLIC_HLS_BASE_URL=https://media-staging.example.invalid
MEDIAMTX_WEBRTC_SIGNALING_PORT=8889
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_WEBRTC_ICE_TCP_PORT=8189
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_RTMP_PORT=1935

# Optional external/NAT ICE settings. Real TURN credentials stay outside git.
# MEDIAMTX_STUN_URL=stun:stun.example.invalid:3478
# MEDIAMTX_TURN_URL=turn:turn.example.invalid:3478?transport=tcp
# MEDIAMTX_TURN_USERNAME=replace-outside-git
# MEDIAMTX_TURN_PASSWORD=replace-outside-git
# MEDIAMTX_TURN_CLIENT_ONLY=false
