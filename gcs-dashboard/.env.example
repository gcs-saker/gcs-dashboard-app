# GCS-Saker local Docker Compose env example.
# Copy to gcs-dashboard/.env for local development only.
# Do not commit real staging/production secrets.

COMPOSE_PROJECT_NAME=gcs-saker-local
LOCAL_BIND_ADDR=127.0.0.1

# Local database. Replace these values outside git for staging/prod.
POSTGRES_DB=gcs_geo
POSTGRES_USER=gcs_geo
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg2://gcs_geo:change-me-local-postgres@postgres:5432/gcs_geo
AUTH_JWT_SECRET=change-me-local-jwt-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_JWT_ISSUER=gcs-saker-local
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174

# Backend and dashboard public ports.
BACKEND_HTTP_PORT=8001
DASHBOARD_HTTP_PORT=3000
BACKEND_IMAGE=gcs-saker-backend:local
DASHBOARD_IMAGE=gcs-saker-dashboard:local

# Public edge ingress. The real certificate directory stays outside git.
PUBLIC_HTTP_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_BIND_ADDR=0.0.0.0
PUBLIC_HTTPS_PORT=443
NGINX_CERTS_DIR=./certs

# MQTT local broker.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_CLIENT_ID=gcs_backend_pub
MQTT_KEEPALIVE=60
MQTT_USERNAME=gcs_backend_pub
MQTT_PASSWORD=change-me-mqtt-password
MQTT_PASSWORD_FILE=../deploy/mosquitto/passwords.local
MQTT_HEALTH_USERNAME=gcs_backend_pub
MQTT_HEALTH_PASSWORD=change-me-mqtt-password
TELEMETRY_BUFFER_AUTO_FLUSH_MAX_ITEMS=1000
CONTROL_MESSAGE_SENDER=mqtt

# Frontend build-time env. Vite bakes these into the dashboard bundle.
VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/auth-policy/auth
VITE_STREAM_API_BASE_URL=/media-control
VITE_HLS_BASE_URL=/hls
VITE_DEFAULT_STREAM_ID=CID001
VITE_LOCAL_WEBCAM_WHIP_URL=https://localhost/webrtc/raw/local/webcam/whip
VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
VITE_MAP_PROVIDER=esri-satellite
VITE_MAP_STYLE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_DEV_PROXY_TARGET=https://a4ai.tplinkdns.com

# Local dashboard-only compose uses an explicit allow-all media-control mode.
# Production/staging/closed-network profiles must keep MEDIA_CONTROL_AUTH_MODE=required.
MEDIA_CONTROL_AUTH_MODE=allow-all

# Backend-provided browser ICE server list. TURN values are read by the backend
# and returned to authenticated dashboard/publisher clients.
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
DASHBOARD_MAP_PROVIDER=esri-satellite
DASHBOARD_MAP_STYLE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
DASHBOARD_MAP_ATTRIBUTION=Esri World Imagery
DASHBOARD_MAP_REQUIRES_API_KEY=false
# WEBRTC_TURN_URL=turn:a4ai.tplinkdns.com:3478?transport=udp
# WEBRTC_TURN_USERNAME=gcs-turn
# WEBRTC_TURN_PASSWORD=replace-with-secret-outside-git
# WEBRTC_TURN_CLIENT_ONLY=false

# Public MediaMTX playback base URLs returned by backend playback APIs.
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=https://localhost/webrtc
MEDIAMTX_PUBLIC_HLS_BASE_URL=https://localhost/hls
MEDIAMTX_API_BASE_URL=http://mediamtx:9997
MEDIA_CONTROL_PUBLIC_WEBRTC_BASE_URL=/webrtc
MEDIA_CONTROL_PUBLIC_HLS_BASE_URL=/hls
MEDIA_CONTROL_PUBLISH_TOKEN=change-me-local-publisher-token
MEDIA_CONTROL_GRPC_LISTEN_ADDR=:9090
MEDIA_CONTROL_GRPC_TOKEN=change-me-local-publisher-token
MEDIA_CONTROL_GRPC_MAX_PAYLOAD_BYTES=65536

# MediaMTX public port mapping for Docker Compose.
# Keep MediaMTX management API and metrics private; do not map them here.
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.15.3
MEDIAMTX_ICE_BIND_ADDR=127.0.0.1
MEDIAMTX_SRT_BIND_ADDR=127.0.0.1
MEDIAMTX_WEBRTC_SIGNALING_PORT=8889
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_WEBRTC_ICE_TCP_PORT=8189
MEDIAMTX_WEBRTC_IPS_FROM_INTERFACES=true
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_RTMP_PORT=1935

# Optional coturn service. Enable with: docker compose --profile turn up -d turn
# Production behind NAT must set TURN_EXTERNAL_IP to the public IP forwarded by the router.
COTURN_IMAGE=coturn/coturn:4.6.3
TURN_BIND_ADDR=0.0.0.0
TURN_PORT=3478
TURN_REALM=a4ai.tplinkdns.com
TURN_EXTERNAL_IP=127.0.0.1

# Optional WebRTC ICE servers for external/NAT deployments.
# Enable MediaMTX TURN awareness with:
# docker compose -f docker-compose.yml -f docker-compose.ice.example.yml --profile turn up -d
# Do not commit real TURN credentials.
# WEBRTC_TURN_URL, WEBRTC_TURN_USERNAME, and WEBRTC_TURN_PASSWORD above are reused by MediaMTX.
