# GCS-Saker local Docker Compose env example.
# Copy to gcs-dashboard/.env for local development only.
# Do not commit real staging/production secrets.

COMPOSE_PROJECT_NAME=gcs-saker-local
LOCAL_BIND_ADDR=127.0.0.1

# Local database. Replace these values outside git for staging/prod.
MYSQL_ROOT_PASSWORD=change-me-local-root
MYSQL_DATABASE=gcs_db
MYSQL_USER=gcs_app
MYSQL_PASSWORD=change-me-local-app
MYSQL_HOST_PORT=3308
DATABASE_URL=mysql+pymysql://gcs_app:change-me-local-app@mysql:3306/gcs_db
AUTH_JWT_SECRET=change-me-local-jwt-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_JWT_ISSUER=gcs-saker-local

# Backend and dashboard public ports.
BACKEND_HTTP_PORT=8001
DASHBOARD_HTTP_PORT=3000
BACKEND_IMAGE=gcs-saker-backend:local
DASHBOARD_IMAGE=gcs-saker-dashboard:local

# Public edge ingress. The real certificate directory stays outside git.
PUBLIC_HTTP_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_BIND_ADDR=0.0.0.0
PUBLIC_HTTPS_PORT=443
NGINX_CERTS_DIR=./certs

# MQTT local broker.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_CLIENT_ID=gcs_backend_pub
MQTT_KEEPALIVE=60

# Frontend build-time env. Vite bakes these into the dashboard bundle.
VITE_API_BASE_URL=/api
VITE_HLS_BASE_URL=/hls
VITE_DEFAULT_STREAM_ID=CID001
VITE_LOCAL_WEBCAM_WHIP_URL=https://localhost/webrtc/raw/local/webcam/whip
VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
VITE_DEV_PROXY_TARGET=https://a4ai.tplinkdns.com

# Public MediaMTX playback base URLs returned by backend playback APIs.
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=https://localhost/webrtc
MEDIAMTX_PUBLIC_HLS_BASE_URL=https://localhost/hls

# MediaMTX public port mapping for Docker Compose.
# Keep MediaMTX management API and metrics private; do not map them here.
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.15.3
MEDIAMTX_ICE_BIND_ADDR=127.0.0.1
MEDIAMTX_SRT_BIND_ADDR=127.0.0.1
MEDIAMTX_WEBRTC_SIGNALING_PORT=8889
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_WEBRTC_ICE_TCP_PORT=8189
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_RTMP_PORT=1935

# Optional WebRTC ICE servers for external/NAT deployments.
# Enable with: docker compose -f docker-compose.yml -f docker-compose.ice.example.yml up
# Do not commit real TURN credentials.
# MEDIAMTX_STUN_URL=stun:stun.example.org:3478
# MEDIAMTX_TURN_URL=turn:turn.example.org:3478?transport=tcp
# MEDIAMTX_TURN_USERNAME=AUTH_SECRET
# MEDIAMTX_TURN_PASSWORD=replace-with-secret-outside-git
# MEDIAMTX_TURN_CLIENT_ONLY=false
