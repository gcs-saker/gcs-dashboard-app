# GCS-Saker closed-network profile.
# Copy values into the private runtime .env for an isolated LAN.

COMPOSE_PROJECT_NAME=gcs-saker-closed
LOCAL_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_BIND_ADDR=127.0.0.1
PUBLIC_HTTPS_BIND_ADDR=0.0.0.0

# Edge-relative browser API paths. Do not point browser code at localhost service ports.
VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/auth-policy/auth
VITE_STREAM_API_BASE_URL=/media-control
VITE_HLS_BASE_URL=/hls
VITE_LOCAL_WEBCAM_WHIP_URL=/webrtc/raw/local/webcam/whip
VITE_MAP_PROVIDER=offline
DASHBOARD_MAP_PROVIDER=offline
DASHBOARD_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
DASHBOARD_MAP_ATTRIBUTION=Closed network offline tactical map
DASHBOARD_MAP_REQUIRES_API_KEY=false

# Closed-network ICE. Replace 10.0.0.10 with the appliance VIP or TURN host in the same LAN.
VITE_WEBRTC_STUN_URL=stun:10.0.0.10:3478
WEBRTC_STUN_URL=stun:10.0.0.10:3478
WEBRTC_TURN_URL=turn:10.0.0.10:3478?transport=udp
MEDIAMTX_WEBRTC_IPS_FROM_INTERFACES=false
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=10.0.0.10
WEBRTC_TURN_USERNAME=gcs-turn
WEBRTC_TURN_PASSWORD=replace-with-secret-outside-git

# Time sync. Closed-network mode uses an internal NTP/time source.
TIME_SYNC_MODE=closed_network
TIME_SYNC_SOURCE_HOST=10.0.0.10
TIME_SYNC_SOURCE_PORT=123
TIME_SYNC_DRIFT_WARN_MS=500

# Media URLs exposed by the edge gateway inside the closed network.
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=/webrtc
MEDIAMTX_PUBLIC_HLS_BASE_URL=/hls
MEDIA_CONTROL_PUBLIC_WEBRTC_BASE_URL=/webrtc
MEDIA_CONTROL_PUBLIC_HLS_BASE_URL=/hls
MEDIA_CONTROL_STUN_URL=stun:10.0.0.10:3478
MEDIA_CONTROL_TURN_PRIMARY_URL=turn:10.0.0.10:3478?transport=udp
MEDIA_CONTROL_TURN_SECONDARY_URL=turn:10.0.0.11:3478?transport=udp

# Secrets must be set privately before deployment.
MYSQL_ROOT_PASSWORD=replace-with-secret-outside-git
MYSQL_PASSWORD=replace-with-secret-outside-git
AUTH_JWT_SECRET=replace-with-at-least-32-characters
