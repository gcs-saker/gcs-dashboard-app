# GCS-Saker production env template.
# Copy to a server-side secret location; do not commit the real file.

COMPOSE_PROJECT_NAME=gcs-saker-production
LOCAL_BIND_ADDR=127.0.0.1

POSTGRES_DB=gcs_geo
POSTGRES_USER=gcs_geo
POSTGRES_PASSWORD=replace-outside-git
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg2://gcs_geo:replace-outside-git@postgres:5432/gcs_geo
AUTH_JWT_SECRET=replace-outside-git
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_JWT_ISSUER=gcs-saker-production
BACKEND_CORS_ALLOW_ORIGINS=https://gcs.example.invalid

BACKEND_HTTP_PORT=8001
DASHBOARD_HTTP_PORT=3000
BACKEND_IMAGE=gcs-saker-backend:production
DASHBOARD_IMAGE=gcs-saker-dashboard:production

PUBLIC_HTTP_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_BIND_ADDR=0.0.0.0
PUBLIC_HTTPS_PORT=443
NGINX_CERTS_DIR=/opt/gcs-saker/private/nginx-certs

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_HOST_PORT=1883
MQTT_CLIENT_ID=gcs_backend_production
MQTT_KEEPALIVE=60

VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/auth-policy/auth
VITE_STREAM_API_BASE_URL=/media-control
VITE_HLS_BASE_URL=/hls
VITE_DEFAULT_STREAM_ID=CID001
VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
VITE_MAP_PROVIDER=esri-satellite
VITE_MAP_STYLE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
DASHBOARD_MAP_PROVIDER=esri-satellite
DASHBOARD_MAP_STYLE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
DASHBOARD_MAP_ATTRIBUTION=Esri World Imagery
DASHBOARD_MAP_REQUIRES_API_KEY=false

MEDIAMTX_IMAGE=bluenviron/mediamtx:1.15.3
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=https://gcs.example.invalid/webrtc
MEDIAMTX_PUBLIC_HLS_BASE_URL=https://gcs.example.invalid/hls
MEDIAMTX_API_BASE_URL=http://mediamtx:9997
MEDIA_CONTROL_PUBLIC_WEBRTC_BASE_URL=/webrtc
MEDIA_CONTROL_PUBLIC_HLS_BASE_URL=/hls
MEDIA_CONTROL_PUBLISH_TOKEN=replace-outside-git
MEDIA_CONTROL_GRPC_LISTEN_ADDR=:9090
MEDIA_CONTROL_GRPC_TOKEN=replace-outside-git
MEDIA_CONTROL_GRPC_MAX_PAYLOAD_BYTES=65536
MEDIA_CONTROL_AUTH_MODE=required
MEDIAMTX_ICE_BIND_ADDR=127.0.0.1
MEDIAMTX_SRT_BIND_ADDR=127.0.0.1
MEDIAMTX_WEBRTC_SIGNALING_PORT=8889
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_WEBRTC_ICE_TCP_PORT=8189
MEDIAMTX_WEBRTC_IPS_FROM_INTERFACES=false
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=gcs.example.invalid
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_RTMP_PORT=1935

# Optional external/NAT ICE settings. Real TURN credentials stay outside git.
# WEBRTC_TURN_URL=turn:turn.example.invalid:3478?transport=udp
# WEBRTC_TURN_USERNAME=replace-outside-git
# WEBRTC_TURN_PASSWORD=replace-outside-git
# WEBRTC_TURN_CLIENT_ONLY=false
COTURN_IMAGE=coturn/coturn:4.6.3
TURN_BIND_ADDR=0.0.0.0
TURN_PORT=3478
TURN_REALM=gcs.example.invalid
TURN_EXTERNAL_IP=127.0.0.1
