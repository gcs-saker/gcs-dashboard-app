# Backend standalone env example.
# Copy to backend/.env for local Docker Compose or set equivalent variables in staging/prod secrets.

# Do not commit real production credentials.
DATABASE_URL=mysql+pymysql://gcs_app:change-me-local-app@mysql:3306/gcs_db

# JWT signing secret for dashboard/operator API access.
# Use a generated secret in each environment and never commit real values.
AUTH_JWT_SECRET=change-me-to-a-random-32-plus-character-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_JWT_ISSUER=gcs-saker

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID=gcs_backend_pub
MQTT_KEEPALIVE=60

# Public MediaMTX playback base URLs used by the backend Playback URL Builder.
# WHEP endpoint: {MEDIAMTX_PUBLIC_WEBRTC_BASE_URL}/{streamPath}/whep
# HLS playlist endpoint: {MEDIAMTX_PUBLIC_HLS_BASE_URL}/{streamPath}/index.m3u8
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=http://localhost:8889
MEDIAMTX_PUBLIC_HLS_BASE_URL=http://localhost:8888

# Browser ICE server list returned by /api/v1/streams/ice-servers.
# Keep real TURN credentials in environment secrets only.
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=turn:a4ai.tplinkdns.com:3478?transport=udp
# WEBRTC_TURN_USERNAME=gcs-turn
# WEBRTC_TURN_PASSWORD=replace-with-secret-outside-git
