type Query {
  operationalEvents(
    query: String
    severity: String
    from: String
    to: String
  ): [OperationalEvent!]!
  operationalEventPage(
    query: String
    severity: String
    from: String
    to: String
    limit: Int
    after: String
  ): OperationalEventPage!
}

type OperationalEvent {
  id: ID!
  occurredAt: String!
  severity: String!
  category: String!
  eventType: String
  sourceService: String
  source: String!
  message: String!
  connections: Int!
  latencyMs: Int!
  throughputMbps: Float!
  streamId: String
  connectionId: String
  icePath: String
  relayFallbackReason: String
}

type OperationalEventPage {
  events: [OperationalEvent!]!
  nextCursor: String
}
