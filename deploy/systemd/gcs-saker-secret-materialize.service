[Unit]
Description=Materialize GCS-Saker service secrets from SOPS
Before=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
RuntimeDirectory=gcs-saker-secrets
RuntimeDirectoryMode=0700
LoadCredentialEncrypted=sops-age-key:/etc/credstore.encrypted/gcs-saker-sops-age-key
Environment=SOPS_AGE_KEY_FILE=%d/sops-age-key
Environment=DEPLOYMENT_TARGET=server01-production
Environment=GCS_SECRET_RUNTIME_GID=10050
ExecStart=/home/user/gcs-saker-runtime/current/scripts/ops/materialize_sops_secrets.sh /home/user/gcs-saker-runtime/server01/secrets.enc.json /run/gcs-saker-secrets
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
