FROM python:3.12-alpine@sha256:dcc0e21003470826202b4bbb3ac8404eb3076b8a5d22119175f4b69edc55bee4

COPY deploy/network/webrtc-probe-requirements.txt /tmp/requirements.txt
RUN apk add --no-cache iproute2=7.0.0-r0 \
    && pip install --no-cache-dir --requirement /tmp/requirements.txt \
    && rm /tmp/requirements.txt
COPY deploy/network/netem-probe-entrypoint.sh /usr/local/bin/gcs-netem-probe
COPY scripts/smoke/ice_pair_observation.py /opt/gcs/ice_pair_observation.py
COPY scripts/smoke/latency_budget.py /opt/gcs/latency_budget.py
COPY scripts/smoke/webrtc_audio_continuity.py /opt/gcs/webrtc_audio_continuity.py
COPY scripts/smoke/webrtc_ice_smoke.py /opt/gcs/webrtc_ice_smoke.py
COPY scripts/smoke/webrtc_whip_publish_smoke.py /opt/gcs/webrtc_whip_publish_smoke.py
COPY scripts/smoke/webrtc_talkback_tone_publisher.py /opt/gcs/webrtc_talkback_tone_publisher.py
COPY scripts/smoke/webrtc_talkback_tone_receiver.py /opt/gcs/webrtc_talkback_tone_receiver.py
RUN chmod 0555 /usr/local/bin/gcs-netem-probe

USER 65534:65534
ENTRYPOINT ["/usr/local/bin/gcs-netem-probe"]
