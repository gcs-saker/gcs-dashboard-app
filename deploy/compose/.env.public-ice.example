# GCS-Saker public NAT ICE profile.
# Copy these non-secret values into the server .env when clients connect through a public DNS name.

MEDIAMTX_ICE_BIND_ADDR=0.0.0.0
MEDIAMTX_WEBRTC_IPS_FROM_INTERFACES=false
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=a4ai.tplinkdns.com

# Keep TURN available as fallback. Direct STUN/srflx paths are preferred when they work.
MEDIA_CONTROL_STUN_URL=stun:a4ai.tplinkdns.com:3478
MEDIA_CONTROL_TURN_PRIMARY_URL=turn:a4ai.tplinkdns.com:3478?transport=udp
MEDIA_CONTROL_TURN_SECONDARY_URL=turn:a4ai.tplinkdns.com:3479?transport=udp
MEDIA_CONTROL_TURN_MAX_HEALTHY_SERVERS=1
