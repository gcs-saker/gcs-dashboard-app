# GCS-Saker closed-network single-node profile.
# Copy this file to a private env file and replace every secret outside Git.

SAKER_NETWORK_PROFILE=closed
COMPOSE_PROJECT_NAME=gcs-saker-closed
LOCAL_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_BIND_ADDR=0.0.0.0
PUBLIC_HTTPS_PORT=443
NGINX_CERTS_DIR=/opt/gcs-saker/private/nginx-certs

POSTGRES_DB=gcs_geo
POSTGRES_USER=gcs_geo
POSTGRES_PASSWORD=replace-with-secret-outside-git
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg2://gcs_geo:replace-with-secret-outside-git@postgres-geo:5432/gcs_geo
REDIS_PASSWORD=replace-with-secret-outside-git

AUTH_JWT_SECRET=replace-with-at-least-32-characters-private-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=strict
AUTH_JWT_ISSUER=gcs-saker
BACKEND_CORS_ALLOW_ORIGINS=https://10.0.0.10
AUTH_POLICY_OPERATOR_PASSWORD=replace-with-secret-outside-git
AUTH_POLICY_SMOKE_PASSWORD=replace-with-secret-outside-git

TIME_SYNC_MODE=closed_network
TIME_SYNC_SOURCE_HOST=10.0.0.10
TIME_SYNC_SOURCE_PORT=123
TIME_SYNC_DRIFT_WARN_MS=500

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID=gcs_backend_pub
MQTT_USERNAME=gcs_backend_pub
MQTT_PASSWORD=replace-with-secret-outside-git
MQTT_PASSWORD_FILE=../mosquitto/passwords.local
MQTT_HEALTH_USERNAME=gcs_backend_pub
MQTT_HEALTH_PASSWORD=replace-with-secret-outside-git
MQTT_V2_TELEMETRY_SUBSCRIBER_ENABLED=false

MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=/webrtc
MEDIAMTX_PUBLIC_HLS_BASE_URL=/hls
MEDIAMTX_API_BASE_URL=http://mediamtx:9997
MEDIAMTX_ICE_BIND_ADDR=127.0.0.1
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_WEBRTC_ICE_TCP_PORT=8189
MEDIAMTX_WEBRTC_IPS_FROM_INTERFACES=false
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=10.0.0.10

TURN_REALM=gcs-saker.closed
TURN_USERNAME=gcs-turn
TURN_PASSWORD=replace-with-secret-outside-git
TURN_PUBLIC_BIND_ADDR=0.0.0.0
TURN_PRIMARY_HOST_PORT=3478
TURN_SECONDARY_HOST_PORT=3479
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
TURN_PRIMARY_RELAY_HOST_MIN_PORT=49160
TURN_PRIMARY_RELAY_HOST_MAX_PORT=49180
TURN_SECONDARY_RELAY_HOST_MIN_PORT=49181
TURN_SECONDARY_RELAY_HOST_MAX_PORT=49200
TURN_EXTERNAL_IP=10.0.0.10

AUTH_POLICY_BASE_URL=http://auth-policy:8080
MEDIA_CONTROL_AUTH_MODE=required
MEDIA_CONTROL_PUBLIC_WEBRTC_BASE_URL=/webrtc
MEDIA_CONTROL_PUBLIC_HLS_BASE_URL=/hls
MEDIA_CONTROL_STUN_URL=stun:10.0.0.10:3478
MEDIA_CONTROL_TURN_PRIMARY_URL=turn:10.0.0.10:3478?transport=udp
MEDIA_CONTROL_TURN_SECONDARY_URL=turn:10.0.0.11:3478?transport=udp
MEDIA_CONTROL_TURN_MAX_HEALTHY_SERVERS=1
MEDIA_CONTROL_PUBLISH_TOKEN=replace-with-secret-outside-git
MEDIA_CONTROL_GRPC_TOKEN=replace-with-secret-outside-git
MEDIA_CONTROL_REDIS_ADDR=redis:6379

VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/auth-policy/auth
VITE_STREAM_API_BASE_URL=/media-control
VITE_HLS_BASE_URL=/hls
VITE_DEFAULT_STREAM_ID=raw/local/webcam
VITE_LOCAL_WEBCAM_WHIP_URL=/webrtc/raw/local/webcam/whip
VITE_WEBRTC_STUN_URL=stun:10.0.0.10:3478
VITE_MAP_PROVIDER=offline
VITE_MAP_STYLE_URL=offline://tactical-map
VITE_STATIC_ASSET_DELIVERY_MODE=offline-bundle
DASHBOARD_MAP_PROVIDER=offline
DASHBOARD_MAP_STYLE_URL=offline://tactical-map
DASHBOARD_MAP_ATTRIBUTION=Closed network offline tactical map
DASHBOARD_MAP_REQUIRES_API_KEY=false
