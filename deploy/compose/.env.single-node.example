COMPOSE_PROJECT_NAME=gcs-saker-arch-poc
LOCAL_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_BIND_ADDR=127.0.0.1
PUBLIC_HTTPS_PORT=8443
NGINX_CERTS_DIR=/opt/gcs-saker/private/nginx-certs

POSTGRES_DB=gcs_geo
POSTGRES_USER=gcs_geo
POSTGRES_PASSWORD=change-me-geo
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg2://gcs_geo:change-me-geo@postgres-geo:5432/gcs_geo
REDIS_PASSWORD=change-me-redis
DRAGONFLY_IMAGE=docker.dragonflydb.io/dragonflydb/dragonfly
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
AUTH_POLICY_REDIS_PRINCIPAL_CACHE_ENABLED=true
AUTH_POLICY_REDIS_REFRESH_SESSION_ENABLED=true
MEDIA_CONTROL_AUTHZ_CACHE_TTL_SECONDS=2

AUTH_JWT_SECRET=replace-with-at-least-32-characters-local-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=120
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_JWT_ISSUER=gcs-saker
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8443,http://127.0.0.1:8443,http://localhost:4177,http://127.0.0.1:4177,http://localhost:4178,http://127.0.0.1:4178
AI_PROCESSOR_ENDPOINTS_JSON={}
AI_STREAM_BASE_URL=http://mediamtx:8889
AI_ADAPTER_TIMEOUT_SECONDS=2.0
AUTH_POLICY_ADMIN_PASSWORD=change-me-admin-password
AUTH_POLICY_OPERATOR_PASSWORD=change-me-operator-password
AUTH_POLICY_SMOKE_PASSWORD=change-me-smoke-password
# Optional local/bootstrap-only static invites. Leave empty in production and issue one-time registration tokens in Admin.
AUTH_POLICY_SIGNUP_INVITES=
AUTH_POLICY_DEVICE_BOOTSTRAP_TOKENS=change-me-bootstrap-token:co-a
AUTH_POLICY_TRACING_SAMPLING_PROBABILITY=1.0
TIME_SYNC_MODE=public
TIME_SYNC_SOURCE_HOST=pool.ntp.org
TIME_SYNC_SOURCE_PORT=123
TIME_SYNC_DRIFT_WARN_MS=1000

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID=gcs_backend_pub
MQTT_KEEPALIVE=60
MQTT_RECONNECT_MIN_DELAY_SECONDS=1
MQTT_RECONNECT_MAX_DELAY_SECONDS=30
MQTT_MAX_INFLIGHT_MESSAGES=20
# Used by backend clients when MQTT auth is enabled.
MQTT_USERNAME=gcs_backend_pub
MQTT_PASSWORD=change-me-mqtt-password
# Used only by the hardened Mosquitto compose override.
MQTT_PASSWORD_FILE=../mosquitto/passwords.local
MQTT_HEALTH_USERNAME=gcs_backend_pub
MQTT_HEALTH_PASSWORD=change-me-mqtt-password
MQTT_V2_TELEMETRY_SUBSCRIBER_ENABLED=false
TELEMETRY_BUFFER_AUTO_FLUSH_MAX_ITEMS=1000
CONTROL_MESSAGE_SENDER=mqtt
CONTROL_GRPC_TARGET=media-control:9090
CONTROL_GRPC_AUTH_TOKEN=change-me-publisher-token
CONTROL_GRPC_TIMEOUT_SECONDS=2

MEDIAMTX_IMAGE=bluenviron/mediamtx:1.15.3
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=http://localhost:8080/webrtc
MEDIAMTX_PUBLIC_HLS_BASE_URL=http://localhost:8080/hls
MEDIAMTX_API_BASE_URL=http://mediamtx:9997
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_ICE_BIND_ADDR=127.0.0.1
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_WEBRTC_ICE_TCP_PORT=8189
# This file keeps local-only defaults. Public/NAT deployments should copy the
# non-secret profile in deploy/compose/.env.public-ice.example so MediaMTX
# advertises a reachable public ICE candidate instead of Docker/private IPs.
MEDIAMTX_WEBRTC_IPS_FROM_INTERFACES=true
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1

TURN_REALM=gcs-saker.closed
TURN_USERNAME=gcs-turn
TURN_PASSWORD=change-me-turn
TURN_PUBLIC_BIND_ADDR=127.0.0.1
TURN_PRIMARY_HOST_PORT=3478
TURN_SECONDARY_HOST_PORT=3479
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
TURN_PRIMARY_RELAY_HOST_MIN_PORT=49160
TURN_PRIMARY_RELAY_HOST_MAX_PORT=49180
TURN_SECONDARY_RELAY_HOST_MIN_PORT=49181
TURN_SECONDARY_RELAY_HOST_MAX_PORT=49200
TURN_EXTERNAL_IP=127.0.0.1
AUTH_POLICY_BASE_URL=http://auth-policy:8080
MEDIA_CONTROL_AUTH_MODE=required
MEDIA_CONTROL_STUN_URL=stun:stun.l.google.com:19302
MEDIA_CONTROL_TURN_PRIMARY_URL=turn:localhost:3478?transport=udp
MEDIA_CONTROL_TURN_SECONDARY_URL=turn:localhost:3479?transport=udp
MEDIA_CONTROL_TURN_MAX_HEALTHY_SERVERS=1
MEDIA_CONTROL_ICE_SERVER_CACHE_TTL_SECONDS=10
MEDIA_CONTROL_ICE_SERVER_CACHE_KEY=gcs-saker:media-control:ice-servers
MEDIA_CONTROL_DEFAULT_PUBLISHER_GROUP_ID=co-a
MEDIA_CONTROL_STREAM_GROUP_MAP=raw/sample/front=co-a,raw/local/webcam=co-a
MEDIA_CONTROL_PUBLISH_TOKEN=change-me-publisher-token
MEDIA_CONTROL_GRPC_LISTEN_ADDR=:9090
MEDIA_CONTROL_GRPC_HOST_PORT=9090
MEDIA_CONTROL_GRPC_TOKEN=change-me-publisher-token
MEDIA_CONTROL_GRPC_MAX_PAYLOAD_BYTES=65536
MEDIA_CONTROL_AUTHZ_CACHE_TTL_SECONDS=2
MEDIA_CONTROL_GOGC=100
MEDIA_CONTROL_GOMEMLIMIT=512MiB
MEDIA_CONTROL_TRACE_EXPORTER=none
MEDIA_CONTROL_OTEL_SERVICE_NAME=gcs-saker-media-control
MEDIA_CONTROL_REDIS_ADDR=redis:6379
MEDIA_CONTROL_STREAM_CACHE_TTL_SECONDS=1
MEDIA_CONTROL_STREAM_PRESENCE_TTL_SECONDS=6

VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/auth-policy/auth
VITE_STREAM_API_BASE_URL=/media-control
VITE_HLS_BASE_URL=/hls
VITE_DEFAULT_STREAM_ID=raw/local/webcam
VITE_LOCAL_WEBCAM_WHIP_URL=http://localhost:8080/webrtc/raw/local/webcam/whip
VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
VITE_MAP_PROVIDER=esri-satellite
VITE_MAP_STYLE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
DASHBOARD_MAP_PROVIDER=esri-satellite
DASHBOARD_MAP_STYLE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
DASHBOARD_MAP_ATTRIBUTION="Esri World Imagery"
DASHBOARD_MAP_REQUIRES_API_KEY=false
