COMPOSE_PROJECT_NAME=gcs-saker-arch-poc
LOCAL_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_BIND_ADDR=127.0.0.1
PUBLIC_HTTPS_PORT=8443
NGINX_CERTS_DIR=/opt/gcs-saker/private/nginx-certs

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=gcs_db
MYSQL_USER=gcs_app
MYSQL_PASSWORD=change-me-app
DATABASE_URL=mysql+pymysql://gcs_app:change-me-app@mysql-legacy:3306/gcs_db

POSTGRES_DB=gcs_geo
POSTGRES_USER=gcs_geo
POSTGRES_PASSWORD=change-me-geo
REDIS_PASSWORD=change-me-redis
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
AUTH_POLICY_REDIS_PRINCIPAL_CACHE_ENABLED=true
AUTH_POLICY_REDIS_REFRESH_SESSION_ENABLED=true
MEDIA_CONTROL_AUTHZ_CACHE_TTL_SECONDS=2

AUTH_JWT_SECRET=replace-with-at-least-32-characters-local-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_JWT_ISSUER=gcs-saker
BACKEND_CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:8443
AUTH_POLICY_SIGNUP_INVITES=A4AI01:1:co-a
TIME_SYNC_MODE=public
TIME_SYNC_SOURCE_HOST=pool.ntp.org
TIME_SYNC_SOURCE_PORT=123
TIME_SYNC_DRIFT_WARN_MS=1000

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_CLIENT_ID=gcs_backend_pub

MEDIAMTX_IMAGE=bluenviron/mediamtx:1.15.3
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=http://localhost:8080/webrtc
MEDIAMTX_PUBLIC_HLS_BASE_URL=http://localhost:8080/hls
MEDIAMTX_API_BASE_URL=http://mediamtx:9997
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_SRT_PORT=8890
MEDIAMTX_ICE_BIND_ADDR=127.0.0.1
MEDIAMTX_WEBRTC_ICE_UDP_PORT=8189
MEDIAMTX_WEBRTC_ICE_TCP_PORT=8189
# Public/NAT deployments must include the server address that clients can reach.
# Example: MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=203.0.113.10
# Public/NAT deployments can set MEDIAMTX_WEBRTC_IPS_FROM_INTERFACES=false to avoid
# advertising Docker/private candidates to external clients.
MEDIAMTX_WEBRTC_IPS_FROM_INTERFACES=true
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=127.0.0.1

TURN_REALM=gcs-saker.closed
TURN_USERNAME=gcs-turn
TURN_PASSWORD=change-me-turn
TURN_PUBLIC_BIND_ADDR=127.0.0.1
TURN_PRIMARY_HOST_PORT=3478
TURN_SECONDARY_HOST_PORT=3479
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
TURN_PRIMARY_RELAY_HOST_MIN_PORT=49160
TURN_PRIMARY_RELAY_HOST_MAX_PORT=49180
TURN_SECONDARY_RELAY_HOST_MIN_PORT=49181
TURN_SECONDARY_RELAY_HOST_MAX_PORT=49200
TURN_EXTERNAL_IP=127.0.0.1
AUTH_POLICY_BASE_URL=http://auth-policy:8080
MEDIA_CONTROL_STUN_URL=stun:localhost:3478
MEDIA_CONTROL_TURN_PRIMARY_URL=turn:localhost:3478?transport=udp
MEDIA_CONTROL_TURN_SECONDARY_URL=turn:localhost:3479?transport=udp
MEDIA_CONTROL_DEFAULT_PUBLISHER_GROUP_ID=co-a
MEDIA_CONTROL_STREAM_GROUP_MAP=raw/sample/front=co-a,raw/local/webcam=co-a
MEDIA_CONTROL_AUTHZ_CACHE_TTL_SECONDS=2
MEDIA_CONTROL_REDIS_ADDR=redis:6379
MEDIA_CONTROL_STREAM_CACHE_TTL_SECONDS=1
MEDIA_CONTROL_STREAM_PRESENCE_TTL_SECONDS=6

VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/auth-policy/auth
VITE_STREAM_API_BASE_URL=/media-control
VITE_HLS_BASE_URL=/hls
VITE_DEFAULT_STREAM_ID=raw/local/webcam
VITE_LOCAL_WEBCAM_WHIP_URL=http://localhost:8080/webrtc/raw/local/webcam/whip
VITE_WEBRTC_STUN_URL=stun:localhost:3478
