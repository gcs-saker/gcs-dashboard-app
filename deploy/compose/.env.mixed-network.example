# GCS-Saker mixed-network profile.
# Use when the control plane can reach public DNS/API, but field devices stay on an internal LAN.

SAKER_NETWORK_PROFILE=mixed
COMPOSE_PROJECT_NAME=gcs-saker-mixed
PUBLIC_HTTP_BIND_ADDR=127.0.0.1
PUBLIC_HTTP_PORT=8080
PUBLIC_HTTPS_BIND_ADDR=0.0.0.0
PUBLIC_HTTPS_PORT=443

# Mixed network keeps edge-relative browser paths.
VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=/auth-policy/auth
VITE_STREAM_API_BASE_URL=/media-control
VITE_HLS_BASE_URL=/hls

# Public map tiles can be used in mixed mode, but the dashboard must still allow offline fallback.
VITE_MAP_PROVIDER=openfreemap
VITE_STATIC_ASSET_DELIVERY_MODE=internal-cdn
DASHBOARD_MAP_PROVIDER=openfreemap
DASHBOARD_MAP_REQUIRES_API_KEY=false

# Prefer internal STUN/TURN for field devices. Public STUN can be used only as an explicit override.
MEDIA_CONTROL_STUN_URL=stun:10.0.0.10:3478
MEDIA_CONTROL_TURN_PRIMARY_URL=turn:10.0.0.10:3478?transport=udp
MEDIA_CONTROL_TURN_SECONDARY_URL=turn:10.0.0.11:3478?transport=udp
MEDIA_CONTROL_TURN_MAX_HEALTHY_SERVERS=1
VITE_WEBRTC_STUN_URL=stun:10.0.0.10:3478
WEBRTC_STUN_URL=stun:10.0.0.10:3478

# Time sync can point at public NTP or a field gateway; choose explicitly per deployment.
TIME_SYNC_MODE=public
TIME_SYNC_SOURCE_HOST=pool.ntp.org
TIME_SYNC_SOURCE_PORT=123
