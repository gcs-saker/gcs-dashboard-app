{
  "schemaVersion": "server01-docker-forwarding-policy-v1",
  "server": "Server-01",
  "dockerPublicBindings": {
    "mediamtx": {
      "tcp": [8189],
      "udp": [8189],
      "udpRanges": []
    },
    "turn-primary": {
      "tcp": [3478, 5349],
      "udp": [3478],
      "udpRanges": [[49160, 49200]]
    },
    "turn-secondary": {
      "tcp": [3478, 5349],
      "udp": [3478],
      "udpRanges": [[49160, 49200]]
    }
  },
  "hostIngress": {
    "tcp": [443, 55121],
    "udp": []
  },
  "hostFirewall": {
    "manager": "ufw",
    "requiredPublicTcp": [443, 55121],
    "forbiddenPublicTcp": [3000, 5432, 6379, 8001, 8080, 8883, 8888, 8889, 9997, 9998]
  },
  "firewall": {
    "requireEstablishedReturn": true,
    "requireTerminalDeny": true,
    "forbidUnconditionalAccept": true,
    "forbidReturnBeforeDeny": true
  }
}
