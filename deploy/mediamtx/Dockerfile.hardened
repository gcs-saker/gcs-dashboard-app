FROM golang:1.26.9-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS build

WORKDIR /src
ADD --checksum=sha256:be643437fed01827ee05c40591326549db82a19eae5c41e12c0252971ed85ac6 \
    https://github.com/bluenviron/mediamtx/archive/2c6727904fbf233615de74a6c54a9b94dbf6025d.tar.gz \
    /tmp/mediamtx.tar.gz
RUN tar -xzf /tmp/mediamtx.tar.gz --strip-components=1 \
    && printf 'v1.21.0' > internal/core/VERSION \
    && (cd internal/servers/hls && go run ./hlsjsdownloader) \
    && go get golang.org/x/crypto@v0.56.0 \
    && go get golang.org/x/net@v0.60.0 \
    && go mod tidy \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mediamtx .
COPY secret-entrypoint.go /tmp/secret-entrypoint.go
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gcs-mediamtx-entrypoint /tmp/secret-entrypoint.go

FROM scratch
ARG SOURCE_COMMIT=unknown
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT
COPY --from=build /out/mediamtx /mediamtx
COPY --from=build /out/gcs-mediamtx-entrypoint /gcs-mediamtx-entrypoint
USER 10001:10001
ENTRYPOINT ["/gcs-mediamtx-entrypoint"]
CMD ["/mediamtx.yml"]
