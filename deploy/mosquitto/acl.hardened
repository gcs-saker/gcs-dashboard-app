# GCS-Saker MQTT ACL
#
# Canonical topic namespace:
#   gcs/device/{deviceUuid}/{publishSession}/{telemetry|result|command|command_ack}
#   gcs/ops/{service}/event
#
# The dashboard must not connect to MQTT directly. Browser clients use REST/JSON
# and WebRTC/HLS through the edge proxy.

user gcs_backend_pub
topic read $SYS/#
# Transitional control publisher removed by #848.
topic write gcs/+/+/+/command
topic write gcs/ops/+/event

user gcs_media_control
topic read gcs/device/+/+/telemetry
topic write gcs/device/+/+/result
topic write gcs/device/+/+/command
topic read gcs/device/+/+/command_ack
topic write gcs/ops/media-control/event

user mqtt-health
topic read $SYS/#

# Device certificate CN is the server-owned device UUID. The publish session is
# additionally validated by Media Control's opaque token/session policy.
pattern write gcs/device/%u/+/telemetry
pattern read gcs/device/%u/+/result
pattern read gcs/device/%u/+/command
pattern write gcs/device/%u/+/command_ack

# Transitional control namespace. Removed by #848.
pattern read gcs/+/+/%u/command
pattern write gcs/+/+/%u/command_ack
